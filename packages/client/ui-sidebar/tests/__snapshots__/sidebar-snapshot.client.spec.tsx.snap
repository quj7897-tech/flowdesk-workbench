// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > hides the floating column while retaining its brand and controls, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="revealZone"
    data-sidebar-expanded="false"
    data-testid="auto-sidebar"
    style="width: 24px;"
  >
    <button
      aria-expanded="false"
      aria-label="Open sidebar"
      class="edgeTrigger"
      tabindex="0"
      type="button"
    />
    <div
      aria-hidden="true"
      class="root quietBars floating"
      inert=""
      style="width: 56px;"
    >
      <div
        class="logoRow"
        data-window-drag="true"
      >
        <button
          aria-label="New session"
          class="brand wide"
          type="button"
        >
          <span
            aria-hidden="true"
            class="brandIdentity"
          >
            <span
              class="brandMark"
            >
              <div
                data-slot="sidebar.brand.mark"
                style="display: contents;"
              >
                <svg
                  aria-hidden="true"
                  class="flowdeskWordmark"
                  data-brand="flowdesk"
                  data-content="2c3c6030"
                  focusable="false"
                  viewBox="64 40 230 65"
                />
              </div>
            </span>
            <span
              class="brandName"
            >
              <div
                data-slot="sidebar.brand.name"
                style="display: contents;"
              />
            </span>
          </span>
        </button>
        <button
          aria-expanded="false"
          aria-label="Open sidebar"
          class="iconButton toggle"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="panelIcon"
            data-content="88020f34"
            fill="none"
            height="16"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
      </div>
      <button
        aria-label="New session"
        class="newSession"
        type="button"
      >
        <span
          class="newSessionLabelMask"
        >
          <span
            class="newSessionContent"
          >
            <svg
              aria-hidden="true"
              data-content="47b5e433"
              fill="none"
              height="14"
              stroke-width="1.3"
              viewBox="0 0 16 16"
              width="14"
              xmlns="http://www.w3.org/2000/svg"
            />
            <span
              class="newSessionLabel wide"
            >
              New Session
            </span>
          </span>
        </span>
      </button>
      <div
        class="regionArea"
      >
        <div
          data-slot="sidebar.workspaces"
          style="display: contents;"
        />
      </div>
      <div
        class="footArea"
      >
        <div
          class="footerActions"
        >
          <div
            data-slot="sidebar.footer.action"
            style="display: contents;"
          />
        </div>
        <div
          class="settingsArea"
        >
          <div
            data-slot="sidebar.settings"
            style="display: contents;"
          />
        </div>
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="windowsZone"
    data-sidebar-expanded="false"
    data-testid="auto-sidebar"
  >
    <div
      class="root collapsed railIn quietBars"
      style=""
    >
      <div
        class="logoRow"
        data-window-drag="true"
      >
        <button
          aria-expanded="false"
          aria-label="Open sidebar"
          class="iconButton toggle"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="panelIcon"
            data-content="88020f34"
            fill="none"
            height="16"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          />
          <div
            data-slot="sidebar.toggle.badge"
            style="display: contents;"
          />
        </button>
      </div>
      <button
        aria-label="New session"
        class="newSession"
        type="button"
      >
        <span
          class="newSessionLabelMask"
        >
          <span
            class="newSessionContent"
          >
            <svg
              aria-hidden="true"
              data-content="47b5e433"
              fill="none"
              height="16"
              stroke-width="1"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
          </span>
        </span>
      </button>
      <div
        class="regionArea"
      >
        <div
          data-slot="sidebar.workspaces"
          style="display: contents;"
        />
      </div>
      <div
        class="footArea"
      >
        <div
          class="footerActions"
        >
          <div
            data-slot="sidebar.footer.action"
            style="display: contents;"
          />
        </div>
        <div
          class="settingsArea"
        >
          <div
            data-slot="sidebar.settings"
            style="display: contents;"
          />
        </div>
      </div>
    </div>
  </div>
</div>
`;

